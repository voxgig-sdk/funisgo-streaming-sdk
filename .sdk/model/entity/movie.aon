# Entity: movie

main: kit: entity: movie: {

  alias: field: {}

  fields: [
    {
      name: "createdAt"
      req: false
      type: "`$STRING`"
    }
    {
      name: "description"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
        update: {
          req: true
          type: "`$STRING`"
        }
      }
      req: false
      type: "`$STRING`"
    }
    {
      name: "duration"
      op: {
        create: {
          req: true
          type: "`$INTEGER`"
        }
        update: {
          req: true
          type: "`$INTEGER`"
        }
      }
      req: false
      short: "Duration in minutes"
      type: "`$INTEGER`"
    }
    {
      name: "genre"
      op: {
        create: {
          req: true
          type: "`$ARRAY`"
        }
        update: {
          req: true
          type: "`$ARRAY`"
        }
      }
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "isPremium"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "rating"
      req: false
      type: "`$NUMBER`"
    }
    {
      name: "releaseYear"
      op: {
        create: {
          req: true
          type: "`$INTEGER`"
        }
        update: {
          req: true
          type: "`$INTEGER`"
        }
      }
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "streamUrl"
      req: false
      type: "`$STRING`"
    }
    {
      name: "thumbnailUrl"
      req: false
      type: "`$STRING`"
    }
    {
      name: "title"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
        update: {
          req: true
          type: "`$STRING`"
        }
      }
      req: false
      type: "`$STRING`"
    }
    {
      name: "updatedAt"
      req: false
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "movie"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/movies"
          parts: [
            "movies"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "genre"
                orig: "genre"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 20
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/movies"
          parts: [
            "movies"
          ]
          select: {
            exist: [
              "genre"
              "limit"
              "page"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "movie_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/movies/{movieId}"
          parts: [
            "movies"
            "{id}"
          ]
          rename: {
            param: {
              movieId: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "movie_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "DELETE"
          orig: "/movies/{movieId}"
          parts: [
            "movies"
            "{id}"
          ]
          rename: {
            param: {
              movieId: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "movie_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "PUT"
          orig: "/movies/{movieId}"
          parts: [
            "movies"
            "{id}"
          ]
          rename: {
            param: {
              movieId: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
