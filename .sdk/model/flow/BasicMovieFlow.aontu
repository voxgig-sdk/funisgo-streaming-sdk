# BasicMovieFlow

main: kit: flow: BasicMovieFlow:
{
  entity: "movie",
  kind: "basic",
  name: "BasicMovieFlow",
  step: [
    {
      input: {
        ref: "movie_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "movie_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "movie_ref01",
        srcdatavar: "movie_ref01_data",
        suffix: "_up0",
        textfield: "createdAt"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-movie_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "movie_ref01",
        srcdatavar: "movie_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "movie01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-movie_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "movie_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "movie01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "movie_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicMovieFlow"
}