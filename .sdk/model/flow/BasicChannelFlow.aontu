# BasicChannelFlow

main: kit: flow: BasicChannelFlow:
{
  entity: "channel",
  kind: "basic",
  name: "BasicChannelFlow",
  step: [
    {
      input: {
        ref: "channel_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "channel_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "channel_ref01",
        srcdatavar: "channel_ref01_data",
        suffix: "_up0",
        textfield: "category"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-channel_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "channel_ref01",
        srcdatavar: "channel_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "channel01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-channel_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "channel_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "channel01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "channel_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicChannelFlow"
}